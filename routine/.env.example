SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
LOG_LEVEL=INFO

# Required by the SEC EDGAR insider-data fallback. SEC asks every automated
# client to identify itself by name + contact email. Set this to your real
# contact in your local .env (not committed) — the line below is a template.
SEC_EDGAR_USER_AGENT=stock-analysis-routine your-email@example.com
